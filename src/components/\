import { useContext } from "react";
import { Link } from "react-router-dom";
import { AppContext } from "../AppContext";

export function Navbar() {
  const {
    userCredentials,
    setUserCredentials,
    cartItems
  } = useContext(AppContext);

  // sum up total items in cart
  const itemCount = cartItems.reduce((sum, item) => sum + item.quantity, 0);

  return (
    <nav className="navbar navbar-expand-lg bg-white border-bottom box-shadow">
      <div className="container">

        <Link className="navbar-brand" to="/">
          <img
            src={process.env.PUBLIC_URL + "/twilightSpiral.png"}
            alt="logo"
            width="30"
            className="me-2"
          />
          EcommDotComm
        </Link>

        <button
          className="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span className="navbar-toggler-icon"></span>
        </button>

        <div
          className="collapse navbar-collapse"
          id="navbarSupportedContent"
        >
          {/* left side nav */}
          <ul className="navbar-nav me-auto mb-2 mb-lg-0">
            <li className="nav-item">
              <Link className="nav-link text-dark" to="/">
                Home
              </Link>
            </li>
            <li className="nav-item">
              <Link className="nav-link text-dark" to="/contact">
                Contact
              </Link>
            </li>
          </ul>

          {/* right side: cart + user dropdown */}
          {userCredentials && (
            <ul className="navbar-nav mb-2 mb-lg-0 ms-auto">
              {/* cart icon */}
              <li className="nav-item ms-3">
                <Link to="/cart" className="nav-link position-relative">
                  <i className="bi bi-cart" style={{ fontSize: "1.2rem" }} />
                  {itemCount > 0 && (
                    <span
                      className="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                      style={{ fontSize: "0.6rem" }}
                    >
                      {itemCount}
                    </span>
                  )}
                </Link>
              </li>

              {/* user dropdown */}
              <li className="nav-item dropdown ms-3">
                <a
                  className="nav-link dropdown-toggle text-dark"
                  href="#"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >
                  {userCredentials.user.role === "admin"
                    ? "Admin"
                    : "Customer"}
                </a>
                <ul className="dropdown-menu">
                  {userCredentials.user.role === "admin" ? (
                    <>
                      <li>
                        <Link
                          className="dropdown-item"
                          to="/admin/products"
                        >
                          Products
                        </Link>
                      </li>
                      <li>
                        <Link
                          className="dropdown-item"
                          to="/admin/users"
                        >
                          Users
                        </Link>
                      </li>
                    </>
                  ) : (
                    <li>
                      <Link
                        className="dropdown-item"
                        to="/profile"
                      >
                        Profile
                      </Link>
                    </li>
                  )}
                  <li>
                    <hr className="dropdown-divider" />
                  </li>
                  <li>
                    <Link
                      className="dropdown-item"
                      onClick={() => setUserCredentials(null)}
                      to="/"
                    >
                      Logout
                    </Link>
                  </li>
                </ul>
              </li>
            </ul>
          )}
        </div>
      </div>
    </nav>
  );
}

export function Footer() {
  return (
    <div className="text-center p-4 border-top">
      <img
        src={process.env.PUBLIC_URL + "/twilightSpiral.png"}
        alt="logo"
        width="30"
        className="me-2"
      />
      EcommDotComm
    </div>
  );
}

